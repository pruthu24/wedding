AI_PROVIDER=openrouter

# OpenRouter Configuration
# Create a free API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
# Other verified active free models on OpenRouter:
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free
# OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

SITE_URL=http://localhost:5173

# Local LM Studio (used if AI_PROVIDER=lmstudio)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model
LM_STUDIO_API_KEY=lm-studio

# Turso Cloud Database Configuration (for Vercel deployment)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_db_token

DATABASE_URL=file:./server/db/wedding.sqlite

ADMIN_AUTH_SECRET=change-this-in-production

WHATSAPP_PROVIDER=none
WHATSAPP_API_KEY=

EMAIL_PROVIDER=none
EMAIL_API_KEY=

PORT=3001
